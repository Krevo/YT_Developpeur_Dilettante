pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	tick = 0
	sol = {
		x = 0
	}
	for i=1,17 do
		add(sol, flr(rnd(8)))
	end
	dino = {
		sp = 0,
		y = 0,
		vy = 0
	}
	cactus = {}
	add_cactus()
end

function  add_cactus()
	if (flr(rnd(2)) == 0) then
		c = get_triple_cactus()
	else
		c = get_grand_cactus()
	end
	add(cactus, c)
end

function get_grand_cactus()
	return {sp = 64, x = 128, h = 3, w = 2}
end

function get_triple_cactus()
	return {sp = 66, x = 128, h = 3, w = 5}
end

function _update()
	tick += 1
	if (tick % 5 == 0 and dino.y == 0) then
		dino.sp = 3 - dino.sp
	end
	-- dino jump
	if (btnp(❎) and dino.y == 0) then
		dino.vy = 4
		dino.sp = 6
	end
	-- gravity
	if (dino.y > 0) then
		dino.vy -= 0.2
	end
	-- apply velocity
	dino.y += dino.vy
	-- jump is finished
	if (dino.y < 0) then
		dino.vy = 0
		dino.y = 0
		dino.sp = 0
	end
	sol.x -= 2
	if (sol.x <= -8) then
		sol.x += 8
		deli(sol, 1)
		add(sol, flr(rnd(8)))
	end
	to_del = 0
	for i, v in ipairs(cactus) do
		v.x -= 2
		--delete element when out of screen
		if (v.x < -v.w * 8) then
			to_del = i
		end
	end
	if (to_del) then
		deli(cactus, to_del)
	end
	if ((#cactus == 0	or (#cactus == 1 and cactus[1].x < 30))
				and flr(rnd(20))==0) then
					add_cactus()
	end
end

function _draw()
	cls()
	rectfill(0,0,127,127,7)
	palt(0, false) -- set black non-transparent
	palt(1, true) -- set dark blue transparent

	for i=1,17 do	
		spr(48+(sol[i]), sol.x+(i-1)*8, 78, 1, 1)
	end

	spr(9, 80, 40, 4, 2) -- nuage
	--spr(64, 100, 58, 2, 3) -- grand cactus
	--spr(66, 50, 58, 5, 3) -- triple cactus
	for i, v in ipairs(cactus) do
		spr(v.sp, v.x, 58, v.w, v.h)
	end
	spr(dino.sp, 5, 60-dino.y, 3, 3)
end
