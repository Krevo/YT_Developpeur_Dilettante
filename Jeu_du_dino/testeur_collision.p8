pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	palt(0, false) -- set black non-transparent
 transp_color = 1
	palt(transp_color, true) -- set dark blue transparent
	debug = 1
	dino = {
		sp = 0,
		y = 20,
  x = 1,
  h = 3,
  w = 3
	}
	cactus = {}
	add(cactus, get_grand_cactus())
	cbounding_box = {}
	pbox = {}
 collide_box = {}
end

function  add_cactus()
	if (flr(rnd(2)) == 0) then
		c = get_triple_cactus()
	else
		c = get_grand_cactus()
	end
	add(cactus, c)
end

function get_grand_cactus()
	return {sp = 64, x = 25, y = 18, h = 3, w = 2}
end

function get_triple_cactus()
	return {sp = 66, x = 128, h = 3, w = 5}
end

function _update()

 if (btnp(➡️)) then
		dino.x += 1
 end
 
 if (btnp(⬅️)) then
		dino.x -= 1
 end

 if (btnp(⬆️)) then
		dino.y -= 1
 end

 if (btnp(⬇️)) then
		dino.y += 1
 end

	cbounding_box = {}
	for i, v in ipairs(cactus) do
		add(cbounding_box, {v.x, v.y, v.x + v.w*8 - 1, v.y+v.h*8 - 1})
	end
	pbox = {dino.x, dino.y, dino.x + dino.w*8-1, dino.y+dino.h*8-1}

	collide_box = {}
	collided_cactus = nil
	res = find_collisions(cbounding_box, pbox)
	if (res!=nil) then
   collide_box = res.cbox
   collided_cactus = res.c
	end
end

function rects(x1, y1, x2, y2, size, color)
 x1 = x1 * size
 x2 = x2 * size + (size-1) -- to be the 'external' pixel
 y1 = y1 * size
 y2 = y2 * size + (size-1) -- to be the 'external' pixel
 --x2 = x1 + (x2-x1+1)*size - 1
 --y2 = y1 + (y2-y1+1)*size - 1
 rect(x1, y1, x2, y2, color)

	print("x1,y1", x1-8, y1-7, color)
	print("x2,y2", x2-8, y2+3, color)
end

function draw_bounding_box(size)
	-- draw bounding box and hit box
	if (debug==1) then
		for i, b in ipairs(cbounding_box) do	
			rects(b[1], b[2], b[3], b[4], size, 3)
		end
		--rects(collide_box[1], collide_box[2], collide_box[3], collide_box[4], size, 8)
	end
end

function info(a,op,b,cond,line)
	print(a, 5, line*6 + 102, 4)
	print(op, 14, line*6 + 102, 7)
	print(b, 23, line*6 + 102, 3)
	if (cond) then
		print("true", 33, line*6 + 102, 11)
	else
		print("false", 33, line*6 + 102, 8)
	end

end

function _draw()
	cls()
	rectfill(0,0,127,127,1)
	palt(0, false) -- set black non-transparent
	palt(1, true) -- set dark blue transparent

	--draw_bounding_box(1)
	draw_bounding_box(2)

	for i, v in ipairs(cactus) do
		--spr(v.sp, v.x, v.y, v.w, v.h)
 	sspr((v.sp % 16) * 8, (v.sp \ 16) * 8, v.w*8, v.h*8, v.x*2, v.y*2, v.w*8*2, v.h*8*2) 
	end

	--rects(pbox[1], pbox[2], pbox[3], pbox[4], 1, 4)
	--spr(dino.sp, dino.x, dino.y, 3, 3)
	
	rects(pbox[1], pbox[2], pbox[3], pbox[4], 2, 4)
	sspr((dino.sp % 16) * 8, (dino.sp \ 16) * 8, 3*8, 3*8, dino.x*2, dino.y*2, 3*8*2, 3*8*2)

	b = cbounding_box[1]
	info("x1","<=","x2", pbox[1]<=b[3], 0)
	info("x2",">=","x1", pbox[3]>=b[1], 1)
	info("y1","<=","y2", pbox[2]<=b[4], 2)
	info("y2",">=","y1", pbox[4]>=b[2], 3)

	print("intersect",60, 102, 7)
	if (#collide_box!=0) then
		rects(collide_box[1], collide_box[2], collide_box[3], collide_box[4], 2, 8)
		print("true",100, 102, 11)
		collide = is_really_colliding(dino, cactus[collided_cactus], collide_box, transp_color, 2, debug)
		print("collide",60, 108, 7)
		if (collide) then
			print("true",100, 108, 11)
		else
			print("false",100, 108, 8)
		end
	else
		print("false",100, 102, 8)
	end
	
	
	
end
-->8
function find_collisions(cbounding_box, pbox)
	for i, c in ipairs(cbounding_box) do
		if (hitbox_collide(c, pbox)) then
			return {c = i, cbox = hitbox_rect(c, pbox)}  
		end
	end
	return nil
end

function hitbox_collide(a,b)
	local c1 = a[2] <= b[4]
	local c2 = a[4] >= b[2]
	local c3 = a[1] <= b[3]
	local c4 = a[3] >= b[1]
	
	if c1 and c2 and c3 and c4 then
		return true
	else
		return false
	end	
end

function hitbox_rect(a,b)
	return {
		max(a[1], b[1]),
		max(a[2], b[2]),
		min(a[3], b[3]),
		min(a[4], b[4])
	}
end

function is_really_colliding(obja, objb, box, transp_color, size, debug)
	collide = false;
	x1 = box[1]
	y1 = box[2]
	x2 = box[3]
	y2 = box[4]
	sp1_x = (obja.sp % 16) * 8
	sp1_y = (obja.sp \ 16) * 8
	sp2_x = (objb.sp % 16) * 8
	sp2_y = (objb.sp \ 16) * 8

	for y=y1, y2 do
		for x=x1, x2 do
		 c1 = sget(
		 	sp1_x + x - flr(obja.x),
		 	sp1_y + y - flr(obja.y))
		 c2 = sget(
		 	sp2_x + x - flr(objb.x),
		 	sp2_y + y - flr(objb.y))
			if (c1!=transp_color 
				and c2!=transp_color) then
				if (debug==1) then
					pset(x*2, y*2, 9)
					rect(x*size, y*size, (x+1)*size-1, (y+1)*size-1, 9)
					collide = true
				else
					return true
				end
			end
 	end
 end
 return collide
end
