pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	palt(0, false) -- set black non-transparent
 transp_color = 1
	palt(transp_color, true) -- set dark blue transparent

	debug = false
	tick = 0
	dinoymax = 60
	sol = {
		x = 0
	}
	for i=1,17 do
		add(sol, flr(rnd(8)))
	end
	cloud = {
		sp = 9,
		x = 80,
		y = 40,
		w = 4,
		h = 2,
		vx = -1
	}
	dino = {
		sp = 0,
		x = 5,
		y = dinoymax,
		h = 3,
		w = 3,
		vy = 0
	}
	cactus = {}
	add_cactus()
	cbounding_box = {}
	pbox = {}
 collide_box = {}
end

function  add_cactus()
	if (flr(rnd(2)) == 0) then
		c = get_triple_cactus()
	else
		c = get_grand_cactus()
	end
	add(cactus, c)
end

function get_grand_cactus()
	return {sp = 64, x = 128, y = 58, h = 3, w = 2}
end

function get_triple_cactus()
	return {sp = 66, x = 128, y = 58, h = 3, w = 5}
end

function _update()
	if (is_game_over and not debug) then
		return
	end
	tick += 1
	if (tick % 5 == 0 and dino.y == dinoymax) then
		dino.sp = 3 - dino.sp
	end
	-- cloud
	cloud.x += cloud.vx
	if (cloud.x < -cloud.w*8) then
		cloud.x = 128
	end
	-- dino jump
	if (btnp(❎) and dino.y == dinoymax) then
		dino.vy = -4
		dino.sp = 6
		sfx(1)
	end
	-- gravity
	if (dino.y < dinoymax) then
		dino.vy += 0.2
	end
	-- apply velocity
	dino.y += dino.vy
	-- jump is finished
	if (dino.y > dinoymax) then
		dino.vy = 0
		dino.y = dinoymax
		dino.sp = 0
	end
	sol.x -= 2
	if (sol.x <= -8) then
		sol.x += 8
		deli(sol, 1)
		add(sol, flr(rnd(8)))
	end
	to_del = 0
	for i, v in ipairs(cactus) do
		v.x -= 2
		--delete element when out of screen
		if (v.x < -v.w * 8) then
			to_del = i
		end
	end
	if (to_del) then
		deli(cactus, to_del)
	end
	if ((#cactus == 0	or (#cactus == 1 and cactus[1].x < 30))
				and flr(rnd(20))==0) then
					add_cactus()
	end

	cbounding_box = {}
	for i, v in ipairs(cactus) do
		add(cbounding_box, {v.x, v.y, v.x + v.w*8 - 1, v.y+v.h*8 - 1})
	end
	pbox = {dino.x, flr(dino.y), dino.x + dino.w*8-1, flr(dino.y+dino.h*8-1)}
	collide_box = {}
	collided_cactus = nil
	res = find_collisions(cbounding_box, pbox)
	if (res!=nil) then
  collide_box = res.cbox
  collided_cactus = res.c
		is_game_over =	is_really_colliding(dino, cactus[collided_cactus], collide_box, transp_color, debug)
		if (is_game_over and not debug) then
			dino.sp = 13
			sfx(0)
		end
	end
end

function _draw()
	cls(7)

	for i=1,17 do	
		spr(48+(sol[i]), sol.x+(i-1)*8, 78, 1, 1)
	end

	spr(cloud.sp, cloud.x, cloud.y, cloud.w, cloud.h) -- nuage
	print(pad(""..flr(tick / 10),4), 110, 5, 1)
	for i, v in ipairs(cactus) do
		spr(v.sp, v.x, v.y, v.w, v.h)
	end
	spr(dino.sp, dino.x, dino.y, dino.w, dino.h)

	-- draw bounding box and hit box
	if (debug) then
		for i, b in ipairs(cbounding_box) do	
			rect(b[1], b[2], b[3], b[4], 3)
  	print(b[1].." "..b[2], 40 + i*30, 100, 3)
  	print(b[3].." "..b[4], 40 + i*30, 110, 3)
  	print(cactus[i].sp, 40 + i*30, 120, 3)
		end
		rect(pbox[1], pbox[2], pbox[3], pbox[4], 4)
  print(pbox[1].." "..pbox[2], 5, 100, 4)
  print(pbox[3].." "..pbox[4], 5, 110, 4)
  print(dino.sp, 5, 120, 4)

		if (#collide_box!=0) then
			rect(collide_box[1], collide_box[2], collide_box[3], collide_box[4], 8)
			is_really_colliding(dino, cactus[collided_cactus], collide_box, transp_color, debug)
  	print(collide_box[1].." "..collide_box[2], 35, 100, 8)
  	print(collide_box[3].." "..collide_box[4], 35, 110, 8)
   print(collided_cactus, 35, 120, 8)
		end
	end
end
-->8
function find_collisions(cbounding_box, pbox)
	for i, c in ipairs(cbounding_box) do
		if (hitbox_collide(c, pbox)) then
			return {c = i, cbox = hitbox_rect(c, pbox)} 
		end
	end
	return nil
end

function hitbox_collide(a,b)
	local c1 = a[2] <= b[4]
	local c2 = a[4] >= b[2]
	local c3 = a[1] <= b[3]
	local c4 = a[3] >= b[1]
	
	if c1 and c2 and c3 and c4 then
		return true
	else
		return false
	end	
end

function hitbox_rect(a,b)
	return {
		max(a[1], b[1]),
		max(a[2], b[2]),
		min(a[3], b[3]),
		min(a[4], b[4])
	}
end

function is_really_colliding(obja, objb, box, transp_color, debug)
	collide = false
	x1 = box[1]
	y1 = box[2]
	x2 = box[3]
	y2 = box[4]
	sp1_x = (obja.sp % 16) * 8
	sp1_y = (obja.sp \ 16) * 8
	sp2_x = (objb.sp % 16) * 8
	sp2_y = (objb.sp \ 16) * 8
	for y=y1, y2 do
		for x=x1, x2 do
		 c1 = sget(
		 	sp1_x + x - flr(obja.x),
		 	sp1_y + y - flr(obja.y))
		 c2 = sget(
		 	sp2_x + x - flr(objb.x),
		 	sp2_y + y - flr(objb.y))
			if (
				c1!=transp_color 
				and c2!=transp_color) then
					if (debug) then
						pset(x, y, 9)
						collide=true
					else
						return true
					end
			end
 	end
 end
	return collide
end

function pad(string,length)
  if (#string==length) return string
  return " "..pad(string, length-1)
end
